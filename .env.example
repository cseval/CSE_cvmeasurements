# ============================================================================
#  CV measurement station — backend environment
#  Copy to .env for local dev; set these as Application Settings on Azure.
# ============================================================================

# --- Database -----------------------------------------------------------
# This is new_lab_pipeline, NOT the production database. The app does not read
# or write production at all any more: no `player`, no `events`, no
# `attendees`, and not production's identity-native lab_movement_screen.
DB_HOST=cse_db_test.csedb.mysql.database.azure.com
DB_PORT=3306
DB_NAME=new_lab_pipeline
DB_USER=
DB_PASSWORD=

# --- Auth ---------------------------------------------------------------
# The shared 6-digit PIN login, the same two PINs the check-in app uses.
# DESK_PIN opens the station; ADMIN_PIN opens it plus anything marked admin.
# They must differ, and each must be exactly 6 digits.
#
# There is no separate signing secret: session tokens are signed with a key
# derived from both PINs and DB_PASSWORD. Changing either PIN, or rotating
# the database password, logs every device out. That is intentional.
DESK_PIN=
ADMIN_PIN=

# The switch that actually closes the API. While this is off, requests with
# no session are still accepted, which is how the backend ships before the
# frontend that logs in. Turn it on once the station is logging in; turning
# it back off is the rollback. Leaving it off leaves the API open.
AUTH_ENFORCE=false

# Transitional, removed in merge 3. Has always been empty in production, so
# the X-Station-Key path has never actually been on.
STATION_API_KEYS=

# Origins allowed to call the API. Empty falls back to "*", which is what the
# previous build shipped with and is not what you want in production.
ALLOWED_ORIGINS=https://your-station.vercel.app

# --- This station -------------------------------------------------------
# Must exist in station_source.code. An unregistered code is rejected rather
# than auto-created — free-text station codes are the thing that lookup table
# exists to prevent.
STATION_CODE=cv_app

# --- Lab time -----------------------------------------------------------
# IANA zone the station physically sits in. Rows store UTC instants, but
# capture_date and the station audit are civil dates, and Denver's UTC date
# rolls over at 6pm local in summer / 5pm in winter. Left on UTC, evening
# sessions were dated tomorrow AND split across two capture_sessions, because
# capture_session is UNIQUE on (subject, station, capture_date, sport, movement).
# /api/health reports the zone and the lab-local date it resolves to.
LAB_TIMEZONE=America/Denver

# --- Photos -------------------------------------------------------------
# Local filesystem by default. App Service local disk is NOT durable across a
# redeploy or a scale-out, so set the Azure variables below for anything real.
ARTIFACT_DIR=/home/site/artifacts

# ARTIFACT_AZURE_CONTAINER=lab-capture
# AZURE_STORAGE_CONNECTION_STRING=
# ...or, for managed identity instead of a connection string:
# ARTIFACT_AZURE_ACCOUNT_URL=https://youraccount.blob.core.windows.net

# Days before a stored photo's purge_after date. These are full-body images of
# minor athletes, so this is a real decision, not a default to inherit. 0 means
# keep indefinitely. The code warns on startup if this is unset.
PHOTO_RETENTION_DAYS=365

# --- NFC ----------------------------------------------------------------
# Must match PREFIX in the reader firmware (NEW Pipeline/hardware/code.py).
# Empty in the current build.
NFC_PREFIX=

LOG_LEVEL=INFO
